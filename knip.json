{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "entry": [
    "src/app/**/*.{ts,tsx}",
    "src/middleware.ts",
    "src/providers/**/*.{ts,tsx}",
    "jest.config.ts",
    "jest.setup.ts"
  ],
  "project": ["src/**/*.{ts,tsx}"],
  "ignore": ["src/lib/utils.ts", "src/lib/supabase/**", "src/types/database.types.ts"],
  "ignoreDependencies": [
    "@supabase/ssr",
    "@supabase/supabase-js",
    "@tailwindcss/postcss",
    "class-variance-authority",
    "clsx",
    "lucide-react",
    "radix-ui",
    "tailwind-merge",
    "tw-animate-css",
    "@testing-library/jest-dom",
    "@testing-library/react",
    "@testing-library/user-event",
    "jest",
    "jest-environment-jsdom",
    "ts-jest",
    "ts-node",
    "shadcn",
    "tailwindcss",
    "postcss"
  ],
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true
  }
}
